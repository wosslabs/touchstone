{
  "gates": {
    "acceptance": "npx cucumber-js --strict",
    "unit": "npm test",
    "duplication": "node quality/dup-check.js",
    "architecture": "node quality/arch-check.js",
    "mutation-code": "node quality/mutate-code.js"
  },
  "quality": [
    "unit",
    "duplication",
    "architecture",
    "mutation-code"
  ],
  "phases": {
    "clean": {
      "allow": [
        "src/**",
        "tests/**"
      ],
      "forbid": [
        "quality/**"
      ],
      "gates": [
        "unit",
        "acceptance",
        "duplication"
      ]
    },
    "architect": {
      "allow": [
        "src/**",
        "tests/**"
      ],
      "forbid": [
        "quality/**"
      ],
      "gates": [
        "unit",
        "acceptance",
        "architecture"
      ]
    },
    "harden": {
      "allow": [
        "tests/**"
      ],
      "forbid": [
        "quality/**"
      ],
      "gates": [
        "unit",
        "acceptance",
        "mutation-code"
      ]
    }
  },
  "protect": [
    "quality/**"
  ]
}
