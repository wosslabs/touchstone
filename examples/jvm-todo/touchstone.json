{
  "gates": {
    "acceptance": "./mvnw -B verify",
    "red": {
      "command": "./mvnw -B -q verify -DskipUnitTests=true -Dcucumber.filter.name=\"$TOUCHSTONE_SCENARIO\" -Dcucumber.plugin=\"message:$TOUCHSTONE_MESSAGES\""
    },
    "unit": "./mvnw -B -q test",
    "architecture": "./mvnw -B -q test -Dtest=ArchitectureTest",
    "mutation-code": "node quality/pit-gate.js --threshold 90 --require example.todo.TaskList --min-mutations 3"
  },
  "quality": [
    "unit",
    "architecture",
    "mutation-code"
  ],
  "mutation": {
    "mode": "warn",
    "maxMutants": 30
  },
  "phases": {
    "clean": {
      "allow": [
        "src/main/**",
        "src/test/**"
      ],
      "gates": [
        "unit",
        "acceptance"
      ]
    },
    "architect": {
      "allow": [
        "src/main/**",
        "src/test/**"
      ],
      "gates": [
        "unit",
        "architecture",
        "acceptance"
      ]
    },
    "harden": {
      "allow": [
        "src/test/**"
      ],
      "gates": [
        "unit",
        "mutation-code"
      ]
    }
  },
  "protect": [
    "quality/**",
    "src/test/java/example/todo/ArchitectureTest.java"
  ]
}
