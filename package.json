{
  "name": "@wosslabs/touchstone",
  "version": "0.11.0",
  "type": "module",
  "description": "Approve a behavior sentence, watch it fail, then build. Every scenario stays traced to the code that runs it.",
  "bin": {
    "touchstone": "cli/touchstone.js"
  },
  "files": [
    "cli/",
    "ci/check-acceptance-guard.js",
    "ci/check-trace.js",
    "ci/gherkin.js",
    "ci/check-red-green.js",
    "ci/red-reason.js",
    "ci/discover.js",
    "ci/check-evidence.js",
    "ci/requirements-doc.js",
    "ci/config.js",
    "ci/gates.js",
    "ci/mutate-gherkin.js",
    "ci/action-config.js",
    "ci/restore-protected.js",
    "hooks/protect-acceptance.js",
    "templates/"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wosslabs/touchstone.git"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "eval": "node evals/run.js",
    "attacks": "node attacks/run.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@cucumber/gherkin": "42.0.1",
    "@cucumber/messages": "34.2.1"
  }
}
